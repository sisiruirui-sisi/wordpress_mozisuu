{
  "manifest_version": 3,
  "name": "WP Blog Counter",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["*://*/wp-admin/post.php*", "*://*/wp-admin/post-new.php*"],
      "js": ["content.js"]
    }
  ]
}